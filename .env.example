# 见岸公网站 · 环境变量示例
# 本地开发：复制为 .env 填入真实值
# 线上部署：请在部署平台的环境变量配置里逐项添加（平台变量优先级高于本文件）

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=none
AIPING_API_KEY=
PORT=

# 访问口令（公网私享用）
# 填了才开启访问门：没输对口令的人既进不了页面，也调不动 /chat
# 多个邀请码用英文逗号分隔，例如：ACCESS_CODE=team-code-1,team-code-2
# ⚠️ 不填 = 访问门关闭，任何人拿到链接都能用你的 Key 聊天，账单算你的
ACCESS_CODE=
# 一次验证有效天数，默认 30
ACCESS_TTL_DAYS=30

# Xingyun avatar session credentials (server only)
XINGYUN_APP_ID=
XINGYUN_APP_SECRET=

# 小暖数字人（仅服务端）
XINGYUN_XIAONUAN_APP_ID=
XINGYUN_XIAONUAN_APP_SECRET=

# 安心数字人（仅服务端）
XINGYUN_ANXIN_APP_ID=
XINGYUN_ANXIN_APP_SECRET=

# 新部署的完整 HTTPS 来源，多个用英文逗号分隔；Render 自动使用 RENDER_EXTERNAL_URL
XINGYUN_ALLOWED_ORIGINS=
